  "finding_seed_not_honoured": {
    "claim": "Ollama 0.40.11 does NOT honour the `seed` field at temperature > 0: two requests with the same seed and temperature 0.8 returned byte-different responses (md5 2d8347970124 vs 46f91dd4f8de). At temperature 0 responses are byte-identical and the seed becomes irrelevant (greedy decoding has nothing to sample).",
    "consequence": "A harness publishing a seed with a stochastic temperature would look reproducible and not be. The harness therefore defaults temperature to 0 and publishes the sampling mode alongside the seed.",
    "evidence": [
      {
        "temperature": 0.0,
        "seed": 42,
        "response_md5": "00bf8ce8383b",
        "identical_with_same_seed": true
      },
      {
        "temperature": 0.0,
        "seed": 42,
        "response_md5": "00bf8ce8383b",
        "identical_with_same_seed": true
      },
      {
        "temperature": 0.0,
        "seed": 43,
        "response_md5": "00bf8ce8383b",
        "identical_with_same_seed": true
      },
      {
        "temperature": 0.8,
        "seed": 42,
        "response_md5": "2d8347970124",
        "identical_with_same_seed": false
      },
      {
        "temperature": 0.8,
        "seed": 42,
        "response_md5": "46f91dd4f8de",
        "identical_with_same_seed": false
      },
      {
        "temperature": 0.8,
        "seed": 43,
        "response_md5": "f1e1ba0ed917",
        "identical_with_same_seed": false
      }
    ]
  },
  "variance_decomposition": {
    "sampling": "lcb-002 (is_even) passes in unseeded draws 1-4 and fails in draw 5: same model, same fixtures, different code. This is the paper's Tier-B defect and the seeding removes it (the seeded band is 0.0pp wide).",
    "infrastructure": "gsm8k-005 timed out at 60s in 4 of 5 unseeded draws and in 5 of 5 seeded draws. A timeout scores 0, so a slow-but-correct answer is indistinguishable from a wrong one. No seeding removes this; the disclosure block counts timeouts under axis 5 so a reader can see how many points were decided by a timeout."
  },
  "gate": {
    "historical_threshold_pp": 3.0,
    "historical_threshold_source": "ADR (internal) Phase 4 D5",
    "measured_unseeded_band_range_pp": 20.0,
    "note": "The historical 3pp gate was 6.7x narrower than the measured 20pp null band. After the change the threshold is derived from the measured band and the verdict additionally requires a paired 95% t interval that excludes zero."
  },
  "fixture_limitation": {
    "fixture_count": 10,
    "composition": "5 GSM8K + 5 LiveCodeBench",
    "statement": "At 10 problems the resolution floor is coarser than the historical 3pp target: a 20pp effect is roughly one problem. eval-delta.sh reports the fixture count required to resolve the threshold effect at 95% confidence rather than hiding the limit."
  }
}
